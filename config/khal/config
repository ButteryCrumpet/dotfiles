[calendars]

[[private]]
path = ~/.calendars/private
color = white

[[private.google]]
path = ~/.calendars/private/crumpetybumpety@gmail.com/
color = 111

[[work]]
path = ~/.calendars/work/simon@issuehunt.io
color = 2
readonly = True

[[holidays]]
path = ~/.calendars/holidays
color = light cyan
readonly = True

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M

[default]
default_calendar = private
highlight_event_days = true
timedelta = 7 days
show_all_days = false

[highlight_days]
default_color = dark green
